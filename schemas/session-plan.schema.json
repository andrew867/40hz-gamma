{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/gamma/session-plan.schema.json",
  "title": "GammaSessionPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "profile",
    "sample_rate",
    "protocol",
    "duration_s",
    "repetition_hz",
    "session_fade_s",
    "breaks",
    "light",
    "noise",
    "normalize",
    "stimulus_peak",
    "playback",
    "safety"
  ],
  "properties": {
    "schema": { "const": "gamma.session_plan.v1" },
    "id": { "type": "string", "minLength": 1 },
    "profile": { "enum": ["research_v1", "web_v1"] },
    "sample_rate": { "type": "integer", "enum": [44100, 48000, 96000] },
    "protocol": { "enum": ["mit_sine_pulse", "human_click_train", "binaural_beat"] },
    "duration_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 7200 },
    "repetition_hz": { "type": "number", "minimum": 1, "maximum": 80 },
    "carrier_hz": { "type": "number", "minimum": 20, "maximum": 20000 },
    "pulse_duration_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.02 },
    "edge": { "enum": ["hard", "raised_cosine_150us"] },
    "click_seed": { "type": "integer", "minimum": 1 },
    "binaural": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_hz", "right_hz"],
      "properties": {
        "left_hz": { "type": "number", "exclusiveMinimum": 0 },
        "right_hz": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "noise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "algorithm", "level_rms", "seed", "follows_envelope"],
      "properties": {
        "enabled": { "type": "boolean" },
        "algorithm": { "enum": ["kellet"] },
        "level_rms": { "type": "number", "minimum": 0, "maximum": 0.2 },
        "seed": { "type": "integer", "minimum": 1 },
        "follows_envelope": { "type": "boolean" }
      }
    },
    "normalize": { "enum": ["fixed_stimulus", "legacy_peak_0_95"] },
    "stimulus_peak": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.95 },
    "session_fade_s": { "type": "number", "minimum": 0, "maximum": 30 },
    "breaks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "interval_s", "duration_s", "fade_s", "placement"],
      "properties": {
        "enabled": { "type": "boolean" },
        "interval_s": { "type": "number", "minimum": 0 },
        "duration_s": { "type": "number", "minimum": 0 },
        "fade_s": { "type": "number", "minimum": 0 },
        "placement": { "enum": ["end", "start"] }
      }
    },
    "light": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "mode", "duty", "phase_offset_us", "threshold", "polarity", "max_duty"],
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "enum": ["audio_envelope", "visual_50", "off"] },
        "duty": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "phase_offset_us": { "type": "number", "minimum": -5000, "maximum": 5000 },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "polarity": { "enum": ["active_high", "active_low"] },
        "max_duty": { "type": "number", "minimum": 0, "maximum": 0.5 }
      }
    },
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volume"],
      "properties": {
        "volume": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["photosensitivity_ack"],
      "properties": {
        "photosensitivity_ack": { "type": "boolean" },
        "ack_unix_ms": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
